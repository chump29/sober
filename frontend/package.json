{
  "name": "sober-frontend",
  "version": "3.2.0",
  "private": true,
  "description": "Sobriety counter (Frontend)",
  "keywords": [
    "sober",
    "sobriety",
    "time",
    "tracker",
    "counter",
    "substance"
  ],
  "homepage": "https://github.com/chump29/sober",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/sober.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "scripts": {
    "build": "bun run --bun vite build",
    "check": "bunx --bun depcheck --ignores=\"@types/*,bun,bun:*,html-validate,lcov-total,rimraf,stylelint-config-standard\" || :",
    "dev": "bun run --bun vite",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome && bun run lint:css && bun run lint:env && bun run lint:html && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:biome:ci": "bun run --bun biome ci --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:ci": "bun run scan && bun run lint:biome:ci && bun run lint:css:ci && bun run lint:env && bun run lint:html && bun run lint:ts",
    "lint:css": "bun run --bun stylelint **/*.css --fix --formatter verbose --ignore-path .gitignore",
    "lint:css:ci": "bun run --bun stylelint **/*.css --formatter verbose --ignore-path .gitignore",
    "lint:env": "bun run --bun dotenv-linter check .",
    "lint:html": "bun run --bun html-validate *.html",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun run --bun tsc",
    "prepare": "cd .. && bun run --bun husky frontend/.husky",
    "prod": "bun run build && cd dist && bunx --bun serve --no-clipboard",
    "scan": "bun audit && bun run --bun cve-lite --check-overrides",
    "test": "bun test --isolate --dots --preload ./tests/dom-setup.ts --preload ./tests/setup.ts --bail",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --preload ./tests/dom-setup.ts --preload ./tests/setup.ts --bail",
    "test:coverage:full": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --preload ./tests/dom-setup.ts --preload ./tests/setup.ts --bail",
    "test:full": "bun test --isolate --preload ./tests/dom-setup.ts --preload ./tests/setup.ts --bail",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --no-must-find-files",
    "*.{json,ts,tsx}": "bun run --bun biome ci --no-errors-on-unmatched --error-on-warnings",
    "*.css": [
      "bun run --bun biome ci --no-errors-on-unmatched --error-on-warnings",
      "bun run --bun stylelint"
    ],
    ".env*": "bun run --bun dotenv-linter check",
    "*.html": "bun run --bun html-validate *.html"
  },
  "overrides": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.1",
    "@types/node": "26.4.1",
    "cspell": "10.2.2",
    "cve-lite-cli": "1.33.0",
    "globals": "17.12.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@jarrodek/pluralize": "^1.0.2",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/modals": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@postfmly/logger": "^1.0.30",
    "@postfmly/types": "^1.0.2",
    "big.js": "^7.0.1",
    "dayjs": "^1.11.23",
    "envalid": "^8.2.0",
    "fast-is-equal": "^1.3.2",
    "http-methods-constants": "^1.1.0",
    "jose": "^6.2.11",
    "ms": "^2.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "swr": "^2.5.1",
    "title-case": "^4.3.2",
    "ts-pattern": "^5.9.0",
    "valibot": "^1.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@happy-dom/global-registrator": "^20.14.0",
    "@postfmly/config": "^1.4.59",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/big.js": "^7.0.0",
    "@types/ms": "^2.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "expect-type": "^1.4.0",
    "extract-numbers": "^2.0.2",
    "fdir-size": "^1.0.3",
    "html-validate": "^11.13.0",
    "http-status-codes": "^2.3.0",
    "husky": "^9.1.7",
    "jest-fetch-mock": "^4.2.0",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.4.1",
    "pretty-bytes": "^7.1.3",
    "rimraf": "^6.1.3",
    "rollup-plugin-jsx-remove-attributes": "^3.1.2",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.2.2",
    "vite-plugin-minify": "^3.0.0",
    "vite-plugin-webfont-dl": "^3.13.1"
  },
  "packageManager": "bun@1.4.1",
  "engines": {
    "bun": "^1.4.1"
  },
  "engineStrict": true,
  "patchedDependencies": {
    "@jarrodek/pluralize@1.0.2": "patches/@jarrodek%2Fpluralize@1.0.2.patch"
  }
}
