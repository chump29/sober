{
  "name": "sober-frontend",
  "version": "4.0.0",
  "private": true,
  "description": "Sobriety tracker (Frontend)",
  "keywords": [
    "sober",
    "sobriety",
    "tracker"
  ],
  "homepage": "https://github.com/chump29/sober",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/sober.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "scripts": {
    "build": "bun run --bun vite build",
    "deps": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*,bun,bun:*,lcov-total\"",
    "dev": "bun run --bun vite",
    "env": "bun run --bun src/env.ts",
    "env:test": "NODE_ENV=test bun run env",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:ts && bun run lint:biome",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:biome:ci": "bun run --bun biome ci --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:ci": "bun run lint:ts && bun run lint:biome:ci",
    "lint:spell": "bun run --bun cspell --dot --root .. .",
    "lint:ts": "bun check",
    "prepare": "bun run --bun lefthook install || :",
    "prepare:commit": "bun run --bun lefthook run pre-commit",
    "prod": "bun run build && cd dist && bunx --bun serve --no-clipboard",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:dupe",
    "scan:audit": "bun audit --production",
    "scan:cve": "bun run --bun cve-lite --check-overrides --check-network --check-maintenance --prod-only --only-used",
    "scan:dupe": "bun dedupe --check",
    "test": "bun test --isolate --dots --bail --check",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-reporter=text --coverage-reporter=lcov --bail --check",
    "test:coverage:full": "TEST_FULL=true bun test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov --bail --check",
    "test:coverage:silent": "bun test --isolate --dots --coverage --coverage-reporter=lcov --bail --check",
    "test:full": "TEST_FULL=true bun test --isolate --bail --check",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "overrides": {
    "aria-query": "5.3.2",
    "react-is": "19.3.1",
    "undici-types": "8.13.1"
  },
  "dependencies": {
    "@jarrodek/pluralize": "1.0.2",
    "@lukeed/ms": "2.0.2",
    "@mantine/charts": "^9.8.2",
    "@mantine/core": "^9.8.2",
    "@mantine/dates": "^9.8.2",
    "@mantine/form": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/modals": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@postfmly/logger": "^1.2.12",
    "@tabler/icons-react": "^3.53.0",
    "dayjs": "^1.11.23",
    "dequal": "^2.0.3",
    "envalid": "^9.0.0",
    "jose": "^6.2.18",
    "magic-regexp": "^0.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "romans": "^3.1.0",
    "swr": "^2.5.1",
    "title-case": "^4.3.2",
    "ts-pattern": "^5.9.2",
    "valibot": "^1.5.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@postfmly/config": "^1.6.47",
    "@postfmly/types": "^1.0.15",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cve-lite-cli": "^1.44.0",
    "expect-type": "^1.4.0",
    "fdir-size": "^1.0.3",
    "jest-fetch-mock": "^4.2.0",
    "lcov-total": "^2.1.1",
    "lefthook": "^2.2.4",
    "lightningcss": "^1.33.0",
    "pretty-bytes": "^7.2.0",
    "rollup-plugin-jsx-remove-attributes": "^3.1.2",
    "vite": "^8.4.0",
    "vite-plugin-minify": "^3.0.0"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": "^1.4.5"
  },
  "engineStrict": true,
  "cpu": [
    "x64",
    "arm64"
  ],
  "patchedDependencies": {
    "@jarrodek/pluralize@1.0.2": "patches/@jarrodek%2Fpluralize@1.0.2.patch",
    "@lukeed/ms@2.0.2": "patches/@lukeed%2Fms@2.0.2.patch"
  }
}
